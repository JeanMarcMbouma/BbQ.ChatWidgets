@using BbQ.ChatWidgets.Blazor.Services
@inject IThemeService ThemeService
@inject IJSRuntime JS
@implements IAsyncDisposable
<div class="theme-switcher">
    <label for="theme-select">Widget theme:</label>
    <select id="theme-select" @onchange="OnThemeChanged" value="@currentTheme">
        @foreach (var theme in ThemeService.AvailableThemes)
        {
            <option value="@theme">@(char.ToUpper(theme[0]) + theme[1..])</option>
        }
    </select>
</div>
@code {
    private string currentTheme = "light";
    private IJSObjectReference? module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/theme-interop.js");
        currentTheme = await JS.InvokeAsync<string>("getSampleTheme");
        if (!ThemeService.AvailableThemes.Contains(currentTheme)) currentTheme = "light";
        await ApplyTheme();
        StateHasChanged();
    }
    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        var theme = e.Value?.ToString();
        if (theme is null || !ThemeService.AvailableThemes.Contains(theme)) return;
        currentTheme = theme;
        await ApplyTheme();
    }
    private async Task ApplyTheme()
    {
        await ThemeService.SetThemeAsync(currentTheme);
        await JS.InvokeVoidAsync("applyThemeClass", currentTheme);
        if (module is not null) await module.InvokeVoidAsync("switchTheme", currentTheme);
    }
    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try { await module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
