@using System.Globalization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using BbQ.ChatWidgets.Sample.Blazor.Components.Layout

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet />
    <!-- BbQ Chat Widgets Theme - Load light theme by default -->
    <!-- The ID must be 'bbq-theme-link' for the JavaScript theme switcher to work -->
    <link rel="stylesheet" id="bbq-theme-link" href="themes/light.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="shared-ui/HomePage.css" />
    <link rel="stylesheet" href="demo-theme.css" />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="sse-widgets.js"></script>
    <script src="sse-clock.js"></script>
    <script type="module">
        import { applyThemeClass, initializeTheme, switchTheme } from '/js/theme-interop.js';
        
        // Expose functions globally for Blazor interop
        window.applyThemeClass = applyThemeClass;
        window.getSampleTheme = () => document.documentElement.classList.contains('theme-dark') ? 'dark' : document.documentElement.classList.contains('theme-corporate') ? 'corporate' : 'light';
        window.switchTheme = switchTheme;
        
        // Wait for page to be fully ready before initializing theme
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                initializeTheme();
            });
        } else {
            initializeTheme();
        }
    </script>
</body>
</html>
