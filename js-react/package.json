{
  "name": "@bbq-chat/widgets-react",
  "version": "1.1.0",
  "description": "Native React components, forms and streaming for BbQ ChatWidgets",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeanMarcMbouma/BbQ.ChatWidgets.git",
    "directory": "js-react"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@bbq-chat/widgets": "^1.1.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "prepublishOnly": "npm run build && npm test && npm run test:package"
  },
  "devDependencies": {
    "@bbq-chat/widgets": "file:../js",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.28.1",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.2",
    "vitest": "4.1.11"
  }
}
