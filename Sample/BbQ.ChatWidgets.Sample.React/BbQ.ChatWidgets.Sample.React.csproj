<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BbQ.ChatWidgets.Sample.React</RootNamespace>
    <AssemblyName>BbQ.ChatWidgets.Sample.React</AssemblyName>
    <UserSecretsId>1dd19de5-a740-4c00-8755-9dcb018ce455</UserSecretsId>
    <SpaRoot>ClientApp\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BbQ.ChatWidgets\BbQ.ChatWidgets.csproj" />
    <ProjectReference Include="..\BbQ.ChatWidgets.Sample.Shared\BbQ.ChatWidgets.Sample.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.0.1-preview.1.25571.5" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <Target Name="BuildClientApp" BeforeTargets="PrepareForBuild" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec WorkingDirectory="../../js" Command="npm ci" />
    <Exec WorkingDirectory="../../js" Command="npm run build" />
    <Exec WorkingDirectory="../../js-react" Command="npm ci" />
    <Exec WorkingDirectory="../../js-react" Command="npm run build" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

  <!-- Discover generated assets after Vite has replaced the previous build. -->
  <ItemGroup>
    <Content Remove="wwwroot/**" />
  </ItemGroup>
  <Target Name="IncludeClientFiles" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildClientApp">
    <ItemGroup>
      <Content Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
